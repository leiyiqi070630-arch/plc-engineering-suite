        "section": "input"
      },
      {
        "name": "Greater",
        "type": "BOOL",
        "section": "output"
      }
    ]
  },
  "expected": [
    "A/B 声明为 INT 输入，Greater 声明为 BOOL 输出；运算符的 dataType=INT 不代表比较结果也为 INT。"
