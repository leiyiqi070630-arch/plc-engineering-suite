          "width": 180,
          "height": 50
        },
        {
          "type": "button",
          "text": "状态详情",
          "name": "StatusButton",
          "left": 260,
          "top": 40,
          "width": 180,
          "height": 50,
          "navigate_to_screen": "Example_status"
        },
        {
          "type": "io_field",
          "tag": "Speed",
          "mode": "InOutput",
          "format_pattern": "999.9",
          "left": 500,
          "top": 40,
          "width": 180,
          "height": 50
        },
        {
          "type": "switch",
