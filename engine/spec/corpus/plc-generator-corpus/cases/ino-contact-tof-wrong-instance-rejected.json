{
  "id": "ino-contact-tof-wrong-instance-rejected",
  "tool": "codesys_lad_generate_contact_block",
  "route": "inoproshop",
  "title": "拒绝反例：TOF 错用 TON 实例（不可写入工程）",
  "covers": [
    "timer-instance-type-rejection",
    "TOF"
  ],
  "language": "LAD",
  "versions": [],
  "keywords": [
    "TOF",
    "拒绝反例",
    "negative",
    "rejection",
    "错型",
    "TON",
    "汇川",
    "inoproshop"
  ],
  "requirements": [
    "TOF 网络错误引用声明为 TON 的 Delay，必须在生成 XML 前拒绝并指出实例声明类型。"
  ],
  "input": {
    "plan": {
      "block_name": "Rejected_TOF",
      "interface": {
        "input": [
          {
            "name": "Enable",
            "datatype": "BOOL"
          }
        ],
        "output": [
          {
            "name": "Q",
            "datatype": "BOOL"
          }
        ],
        "static_members": [
          {
            "name": "Delay",
            "datatype": "TON"
          }
        ]
      },
      "networks": [
        {
          "type": "timer",
          "timer": "TOF",
          "instance": {
            "name": "Delay"
          },
          "input": {
            "name": "Enable"
          },
          "pt": {
            "constant_value": "T#2s"
          },
          "q": {
            "name": "Q"
          }
        }
      ]
    },
    "confirm": "generate_contact_block",
    "disposable": true
  },
  "expected": [
    "只接受 PlanRejected，且诊断路径、期望 TOF declared member、实际 TON 全部相符。",
    "这是故意错误的离线拒绝反例，没有 XML 输出，不能直接作为写入工程的正例。"
  ],
  "preconditions": [
    "仅用于学习类型约束或离线拒绝回归，不调用任何工程写入工具。",
    "要获得可写正例，使用 ino-contact-tof 并适配真实符号。"
  ],
  "pitfalls": [
    "支路的 contacts 当前仅支持一个接点；复杂条件先算为命名 BOOL，不要套用 TIA 的递归 branches。",
    "接点生成器不接受 GVL 点号操作数；需要外部符号时用原生指令入口并给出类型。",
    "定时器实例类型必须与网络类型一致；不能用 TON 声明代替 TOF。"
  ],
  "evidence": [
    {
      "stage": "offline-rejection",
      "path": "evidence/ino-contact-tof-wrong-instance-rejected.offline-rejection.json",
      "sha256": "2fc31f748db989c6901be401b3c9bac50bafadf51aa0dfb6b07b95e195962f41"
    }
  ],
  "rejectionSpec": {
    "exceptionType": "PlanRejected",
    "issues": [
      {
        "path": "plan.networks[0].instance (instance 'Delay')",
        "expected": "TOF declared member",
        "actual": "TON"
      }
    ]
  }
}
