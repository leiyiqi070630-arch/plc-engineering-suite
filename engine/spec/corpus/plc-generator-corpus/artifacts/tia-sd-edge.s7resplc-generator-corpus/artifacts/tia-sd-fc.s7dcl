{
    S7_Optimized := "TRUE";
    S7_Language := "LAD";
}
FUNCTION "FC_Example" : Void
    VAR_INPUT
        A : Bool;
        B : Bool;
    END_VAR
    VAR_OUTPUT
        Q : Bool;
    END_VAR

    { S7_Language := "LAD" }
    NETWORK
        RUNG wire#powerrail
            Contact( #A )
            I_Contact( #B )
            Coil( #Q )
        END_RUNG
    END_NETWORK
END_FUNCTION
