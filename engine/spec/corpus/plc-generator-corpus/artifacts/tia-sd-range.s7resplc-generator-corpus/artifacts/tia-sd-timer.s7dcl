{
    S7_Optimized := "TRUE";
    S7_Language := "LAD";
}
FUNCTION_BLOCK "FB_SD_timer"
    VAR_INPUT
        Enable : Bool;
    END_VAR
    VAR_OUTPUT
        Q : Bool;
        Elapsed : Time;
    END_VAR
    VAR
        { S7_Setpoint := "False" }
        Delay : TON_TIME;
    END_VAR

    { S7_Language := "LAD" }
    NETWORK
        RUNG wire#powerrail
            Contact( #Enable )
            #Delay.TON{ time_type := Time }(
                PT := T#2s,
                ET => #Elapsed
            )
            Coil( #Q )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
