{
    S7_Optimized := "TRUE";
    S7_Language := "LAD";
}
FUNCTION_BLOCK "FB_SD_box"
    VAR_INPUT
        Value : Int;
    END_VAR
    VAR_OUTPUT
        Limited : Int;
    END_VAR

    { S7_Language := "LAD" }
    NETWORK
        RUNG wire#powerrail
            LIMIT(
                MN := 0,
                IN := #Value,
                MX := 100,
                OUT => #Limited
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
