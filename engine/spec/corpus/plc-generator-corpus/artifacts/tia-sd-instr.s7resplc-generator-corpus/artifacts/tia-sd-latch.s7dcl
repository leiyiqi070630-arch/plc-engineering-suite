{
    S7_Optimized := "TRUE";
    S7_Language := "LAD";
}
FUNCTION_BLOCK "FB_SD_latch"
    VAR_INPUT
        Set : Bool;
        Reset : Bool;
    END_VAR
    VAR_OUTPUT
        Q : Bool;
    END_VAR

    { S7_Language := "LAD" }
    NETWORK
        RUNG wire#powerrail
            Contact( #Set )
            S_Coil( #Q )
        END_RUNG
    END_NETWORK
    { S7_Language := "LAD" }
    NETWORK
        RUNG wire#powerrail
            Contact( #Reset )
            R_Coil( #Q )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
