{
    S7_Optimized := "TRUE";
    S7_Language := "LAD";
}
FUNCTION_BLOCK "FB_SD_range"
    VAR_INPUT
        Value : Int;
    END_VAR
    VAR_OUTPUT
        Q : Bool;
    END_VAR

    { S7_Language := "LAD" }
    NETWORK
        RUNG wire#powerrail
            InRange{ SrcType := Int }(
                MIN := 0,
                IN := #Value,
                MAX := 100
            )
            Coil( #Q )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
