{
    S7_Optimized := "TRUE";
    S7_Language := "LAD";
}
FUNCTION_BLOCK "FB_SD_Parallel"
    VAR_INPUT
        A : Bool;
        B : Bool;
    END_VAR
    VAR_OUTPUT
        Q : Bool;
    END_VAR

    { S7_Language := "LAD" }
    NETWORK
        RUNG wire#powerrail
            Contact( #A )
            wire#cc1
            Coil( #Q )
        END_RUNG
        RUNG wire#powerrail
            Contact( #B )
        END_RUNG wire#cc1
    END_NETWORK
END_FUNCTION_BLOCK
