{
    S7_Optimized := "TRUE";
    S7_Language := "LAD";
}
FUNCTION_BLOCK "FB_SD_edge"
    VAR_INPUT
        Signal : Bool;
    END_VAR
    VAR_OUTPUT
        Pulse : Bool;
    END_VAR
    VAR
        Previous : Bool;
    END_VAR

    { S7_Language := "LAD" }
    NETWORK
        RUNG wire#powerrail
            P_Contact(
                operand := #Signal,
                bit := #Previous
            )
            Coil( #Pulse )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
