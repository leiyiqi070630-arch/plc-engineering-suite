{
    S7_Optimized := "TRUE";
    S7_Language := "LAD";
}
FUNCTION_BLOCK "FB_SD_instr"
    VAR_INPUT
        A : Int;
    END_VAR
    VAR_OUTPUT
        B : Int;
    END_VAR

    { S7_Language := "LAD" }
    NETWORK
        RUNG wire#powerrail
            
            MOVE{ DisableENO := FALSE }(
                IN := #A,
                OUT1 => #B
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
