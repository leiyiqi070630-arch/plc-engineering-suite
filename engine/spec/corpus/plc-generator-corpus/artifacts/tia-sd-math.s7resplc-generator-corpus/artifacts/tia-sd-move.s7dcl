{
    S7_Optimized := "TRUE";
    S7_Language := "LAD";
}
FUNCTION_BLOCK "FB_SD_move"
    VAR_OUTPUT
        X : Int;
        Y : Int;
    END_VAR

    { S7_Language := "LAD" }
    NETWORK
        RUNG wire#powerrail
            Move{
                Card := 2; 
                DisableENO := FALSE
            }(
                IN := 7,
                OUT1 => #X,
                OUT2 => #Y
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
