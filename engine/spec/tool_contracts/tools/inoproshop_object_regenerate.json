{
 "contract": {
  "name": "inoproshop_object_regenerate",
  "description": "Generates object from a structured plan. Inputs: confirm, declaration, disposable, kind, name, networks, symbolTypes, target. Required: target, kind, confirm, disposable. Returns a structured result with status and diagnostics.",
  "permission": "DangerFullAccess",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "confirm": {
     "const": "regenerate_object",
     "type": "string"
    },
    "declaration": {
     "type": "string"
    },
    "disposable": {
     "const": true,
     "type": "boolean"
    },
    "kind": {
     "enum": [
      "gvl",
      "lad"
     ],
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "networks": {
     "type": "array"
    },
    "symbolTypes": {
     "additionalProperties": {
      "minLength": 1,
      "type": "string"
     },
     "type": "object"
    },
    "target": {
     "type": "string"
    }
   },
   "required": [
    "target",
    "kind",
    "confirm",
    "disposable"
   ],
   "type": "object"
  }
 }
}