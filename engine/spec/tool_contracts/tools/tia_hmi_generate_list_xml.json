{
 "contract": {
  "name": "tia_hmi_generate_list_xml",
  "description": "Generates HMI list XML from a structured plan. Inputs: output_path, plan. Required: plan. Returns a structured result with status and diagnostics.",
  "permission": "WorkspaceWrite",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "output_path": {
     "type": "string"
    },
    "plan": {
     "additionalProperties": false,
     "properties": {
      "culture": {
       "type": "string"
      },
      "entries": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "default_entry": {
          "type": "boolean"
         },
         "entry_type": {
          "type": "string"
         },
         "from": {
          "type": "integer"
         },
         "picture": {
          "type": "string"
         },
         "text": {
          "type": "string"
         },
         "to": {
          "type": "integer"
         }
        },
        "type": "object"
       },
       "type": "array"
      },
      "kind": {
       "type": "string"
      },
      "list_range": {
       "type": "string"
      },
      "mode": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "schema_version": {
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    }
   },
   "required": [
    "plan"
   ],
   "type": "object"
  }
 }
}