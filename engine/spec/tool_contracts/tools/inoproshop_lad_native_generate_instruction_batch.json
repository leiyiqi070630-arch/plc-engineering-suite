{
 "contract": {
  "name": "inoproshop_lad_native_generate_instruction_batch",
  "description": "Generates LAD instruction batch from a structured plan. Inputs: confirm, disposable, name, networks, parent, pouName, symbolTypes, variables. Required: name, networks, confirm, disposable. Returns a structured result with status and diagnostics.",
  "permission": "DangerFullAccess",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "confirm": {
     "const": "generate_native_lad_instruction_batch",
     "type": "string"
    },
    "disposable": {
     "const": true,
     "type": "boolean"
    },
    "name": {
     "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
     "type": "string"
    },
    "networks": {
     "items": {
      "additionalProperties": false,
      "properties": {
       "instructions": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "dataType": {
           "minLength": 1,
           "type": "string"
          },
          "inouts": {
           "additionalProperties": {
            "minLength": 1,
            "type": "string"
           },
           "type": "object"
          },
          "inputs": {
           "additionalProperties": {
            "minLength": 1,
            "type": "string"
           },
           "type": "object"
          },
          "instance": {
           "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
           "type": "string"
          },
          "instruction": {
           "minLength": 1,
           "type": "string"
          },
          "namespace": {
           "minLength": 1,
           "type": "string"
          },
          "objectGuid": {
           "minLength": 1,
           "type": "string"
          },
          "outputs": {
           "additionalProperties": {
            "minLength": 1,
            "type": "string"
           },
           "type": "object"
          },
          "symbolTypes": {
           "additionalProperties": {
            "minLength": 1,
            "type": "string"
           },
           "type": "object"
          }
         },
         "required": [
          "instruction"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       },
       "title": {
        "type": "string"
       }
      },
      "required": [
       "instructions"
      ],
      "type": "object"
     },
     "maxItems": 64,
     "minItems": 1,
     "type": "array"
    },
    "parent": {
     "default": "Device/Plc Logic/Application",
     "enum": [
      "Application",
      "Device/Plc Logic/Application"
     ],
     "type": "string"
    },
    "pouName": {
     "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
     "type": "string"
    },
    "symbolTypes": {
     "additionalProperties": {
      "minLength": 1,
      "type": "string"
     },
     "type": "object"
    },
    "variables": {
     "items": {
      "additionalProperties": false,
      "properties": {
       "name": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
        "type": "string"
       },
       "section": {
        "default": "local",
        "enum": [
         "input",
         "output",
         "local"
        ],
        "type": "string"
       },
       "type": {
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "name",
       "type"
      ],
      "type": "object"
     },
     "type": "array"
    }
   },
   "required": [
    "name",
    "networks",
    "confirm",
    "disposable"
   ],
   "type": "object"
  }
 }
}